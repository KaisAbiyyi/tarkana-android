<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude encrypted SharedPreferences to prevent AEAD decryption errors across devices/restores -->
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_pref__.xml" />

        <!-- Exclude local-only crash telemetry reports -->
        <exclude domain="file" path="crash_reports" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude hardware-bound encrypted credentials from direct device migration -->
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_file_pref__.xml" />

        <!-- Exclude local-only crash telemetry reports -->
        <exclude domain="file" path="crash_reports" />
    </device-transfer>
</data-extraction-rules>